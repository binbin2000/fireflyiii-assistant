FIREFLY_BASE_URL=https://firefly.example.com
FIREFLY_ACCESS_TOKEN=your-personal-access-token



# Ollama runs locally by default
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=120000

# OIDC login (optional). Leave all of these unset to run without a login wall.
# Set all of them to require sign-in through your OIDC provider (Authelia, Keycloak, Authentik, etc.).
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Single Sign-On
OIDC_GROUPS_CLAIM=groups
OIDC_REQUIRED_GROUP=firefly_users
