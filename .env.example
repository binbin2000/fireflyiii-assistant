# ── Firefly III (obligatorisk) ───────────────────────────────────────────────
FIREFLY_URL=https://ditt-firefly.example.com
FIREFLY_TOKEN=ditt-personliga-access-token

# ── AI-backend (valfri – välj EN av alternativen nedan) ──────────────────────
#
# Alternativ A: Claude API (Anthropic)
#   OBS: Transaktionsbeskrivningar skickas till Anthropics servrar.
#   Inga kontonummer, exakta belopp eller kontonamn skickas.
#   Läs Anthropics integritetspolicy: https://www.anthropic.com/privacy
#
# ANTHROPIC_API_KEY=sk-ant-...
#
# Alternativ B: Ollama (lokal LLM – ingen data lämnar din dator)
#   Installera Ollama: https://ollama.com
#   Kör sedan: ollama pull llama3 (eller annan modell)
#
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
#
# Om VARKEN Claude eller Ollama konfigureras används enbart lokal mönstermatchning
# mot din Firefly III-historik. Ingen data skickas någonstans. (Rekommenderat)
