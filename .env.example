# ── Firefly III (obligatorisk) ───────────────────────────────────────────────
FIREFLY_URL=https://ditt-firefly.example.com
FIREFLY_TOKEN=ditt-personliga-access-token

# ── AI-backend (valfri – välj EN) ────────────────────────────────────────────
# Alternativ A: Claude API  – transaktionsbeskrivningar skickas till Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# Alternativ B: Ollama – 100 % lokal, ingen data lämnar datorn
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Docker / Produktion ──────────────────────────────────────────────────────
# Domän som Traefik routar till containern
APP_DOMAIN=kategoriserare.example.com

# Sätt till true bakom Traefik + Authelia.
# Blockerar anrop utan Remote-User-header (injiceras av Authelia).
REQUIRE_FORWARDED_AUTH=false
